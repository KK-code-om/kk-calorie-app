<!DOCTYPE html>
<html lang="lv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KK Calories V7.2 STABLE</title>

  <link rel="stylesheet" href="style.css?v=7.2-stable" />
  <link rel="manifest" href="manifest.json?v=7.2-stable" />

  <meta name="theme-color" content="#ffffff" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="KK Calories" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
</head>

<body>
  <main class="app">
    <header class="header">
      <div>
        <h1>KK Calories</h1>
        <p id="dateLabel">Šodien</p>
      </div>
      <button class="round-btn" onclick="showTab('nutrition')">+</button>
    </header>

    <section id="overview" class="screen active-screen">
      <section class="hero-card">
        <div class="date-row">
          <button onclick="changeDay(-1)">←</button>
          <input id="datePicker" type="date" onchange="setDateFromPicker()" />
          <button onclick="changeDay(1)">→</button>
        </div>

        <div class="gauge" id="gauge">
          <div class="gauge-value">
            <span id="totalKcal">0</span>
            <small>/<span id="targetKcal">1900</span> kcal</small>
            <p>Atlikums: <b id="remainingKcal">1900</b> kcal</p>
          </div>
        </div>
      </section>

      <section class="macro-row">
        <div class="mini-card"><span>🔥</span><b id="kcalMini">0</b><small>Kalorijas</small></div>
        <div class="mini-card"><span>💪</span><b id="proteinMini">0 g</b><small>Proteīns</small></div>
        <div class="mini-card"><span>🌾</span><b id="carbsMini">0 g</b><small>Ogļhidrāti</small></div>
        <div class="mini-card"><span>💧</span><b id="fatMini">0 g</b><small>Tauki</small></div>
      </section>

      

      <section class="card">
        <h2>Produkts gramos</h2>
        <select id="portionFood"></select>
        <input id="portionGrams" type="number" placeholder="Grami" />
        <select id="portionMeal">
          <option value="breakfast">Brokastis</option>
          <option value="lunch">Pusdienas</option>
          <option value="dinner">Vakariņas</option>
          <option value="snack">Uzkoda</option>
        </select>
        <button onclick="addPortionFood()">Pievienot</button>
      </section>

      <section class="card">
        <h2>Manuāli</h2>
        <input id="foodName" placeholder="Ēdiens" />
        <input id="kcal" type="number" placeholder="kcal" />
        <input id="protein" type="number" step="0.1" placeholder="Proteīns g" />
        <input id="carbs" type="number" step="0.1" placeholder="Ogļhidrāti g" />
        <input id="fat" type="number" step="0.1" placeholder="Tauki g" />
        <button onclick="addManualFood()">Pievienot manuāli</button>
      </section>

      <section class="card">
        <h2>Ieraksti</h2>
        <div id="foodList"></div>
        <button class="danger" onclick="resetDay()">Dzēst dienu</button>
      </section>
    
      <section class="card">
        <h2>Šabloni</h2>
        <input id="tmplName" placeholder="Šablona nosaukums" />
        <button onclick="createTemplate()">Saglabāt šodienu kā šablonu</button>
        <div id="templateList"></div>
      </section>
    
    <section id="products" class="screen">
      <section class="card">
        <h2>Barcode kamera</h2>
        <video id="barcodeVideo" playsinline style="width:100%;border-radius:14px;display:none;"></video>
        <button onclick="startBarcodeCamera()">Skenēt ar kameru</button>
        <button onclick="stopBarcodeCamera()">Apturēt kameru</button>
        <p id="barcodeCameraStatus" class="muted"></p>
      </section>

      <section class="card">
        <h2>Barcode</h2>
        <input id="barcodeInput" placeholder="EAN kods..." />
        <button onclick="lookupBarcode()">Meklēt</button>
        <p id="barcodeStatus" class="muted"></p>
      </section>

      <section class="card">
        <h2>Produkts uz 100g</h2>
        <input id="pName" placeholder="Nosaukums" />
        <input id="pKcal" type="number" placeholder="kcal / 100g" />
        <input id="pProtein" type="number" step="0.1" placeholder="Proteīns / 100g" />
        <input id="pCarbs" type="number" step="0.1" placeholder="Ogļhidrāti / 100g" />
        <input id="pFat" type="number" step="0.1" placeholder="Tauki / 100g" />
        <button onclick="saveProduct()">Saglabāt produktu</button>
      </section>

      <section class="card">
        <h2>CSV import produktiem</h2>
        <p class="muted">Kolonnas: name,kcal,protein,carbs,fat</p>
        <textarea id="csvImportBox" placeholder="name,kcal,protein,carbs,fat"></textarea>
        <button onclick="importProductsCSV()">Importēt CSV</button>
        <div id="csvImportStatus" class="import-status">CSV import gatavs.</div>
      </section>

      <section class="card">
        <h2>Produktu DB</h2>
        <input id="productSearch" placeholder="Meklēt produktu DB..." oninput="renderProducts()" />
        <div id="productList"></div>
      </section>
    </section>

    <section id="recipes" class="screen">
      <section class="card">
        <h2>Jauna recepte</h2>
        <input id="rName" placeholder="Receptes nosaukums" />
        <input id="rYield" type="number" placeholder="Gatavais svars gramos" />
        <select id="rProduct"></select>
        <input id="rGrams" type="number" placeholder="Sastāvdaļas grami" />
        <button onclick="addIngredient()">Pievienot sastāvdaļu</button>
        <div id="ingredientList"></div>
        <button onclick="saveRecipe()">Saglabāt recepti</button>
      </section>

      <section class="card">
        <h2>Pievienot recepti dienai</h2>
        <select id="recipeSelectToday"></select>
        <input id="recipeConsumedGrams" type="number" placeholder="Apēstie grami" />
        <select id="recipeMealToday">
          <option value="breakfast">Brokastis</option>
          <option value="lunch">Pusdienas</option>
          <option value="dinner">Vakariņas</option>
          <option value="snack">Uzkoda</option>
        </select>
        <button onclick="addRecipePortion()">Pievienot porciju</button>
      </section>

      <section class="card">
        <h2>Receptes</h2>
        <div id="recipeList"></div>
      </section>
    </section>

    <section id="settings" class="screen">
      <section class="card">
        <h2>Svars</h2>
        <input id="weightInput" type="number" step="0.1" placeholder="Svars kg" />
        <button onclick="saveWeight()">Saglabāt svaru</button>
        <p id="lastWeight"></p>
      </section>

      <section class="card">
        <h2>KK mērķi</h2>
        <input id="setKcal" type="number" placeholder="kcal" />
        <input id="setProtein" type="number" placeholder="Proteīns" />
        <input id="setCarbs" type="number" placeholder="Ogļhidrāti" />
        <input id="setFat" type="number" placeholder="Tauki" />
        <input id="setWater" type="number" placeholder="Ūdens ml" />
        <button onclick="saveSettings()">Saglabāt</button>
      </section>

      <section class="card">
        <h2>Eksports</h2>
        <button onclick="exportData()">Export JSON</button>
        <input id="importJsonFile" type="file" accept=".json" onchange="importDataFromFile(event)" />
        <p id="importStatus" class="muted"></p>
      </section>
    </section>
  </main>

  <nav class="bottom-nav">
    <button onclick="showTab('overview')" id="tab-overview" class="active">Pārskats</button>
    <button onclick="showTab('nutrition')" id="tab-nutrition">Uzturs</button>
    <button onclick="showTab('products')" id="tab-products">Produkti</button>
    <button onclick="showTab('recipes')" id="tab-recipes">Receptes</button>
    <button onclick="showTab('settings')" id="tab-settings">Set</button>
  </nav>

  <script src="app.js?v=7.2-stable"></script>
</body>
</html>
